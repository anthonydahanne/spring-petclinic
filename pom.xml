<!--                    -Dspring.jpa.hibernate.ddl-auto=none-->
<!--                    -Dspring.sql.init.mode=never-->
<!--                    -Dspring.data.jdbc.dialect=postgresql-->
<!--                    -Dspring.data.mongodb.auto-index-creation=false-->
<!--                    -Dspring.data.redis.lettuce.pool.enabled=false-->
<!--                    -Dspring.data.redis.jedis.pool.enabled=false-->
<!--                    -Dspring.batch.jdbc.initialize-schema=never-->
<!--                    -Dspring.flyway.enabled=false-->
<!--                    -Dspring.liquibase.enabled=false-->
<!--                  </TRAINING_RUN_JAVA_TOOL_OPTIONS>-->
                </env>
              </image>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
